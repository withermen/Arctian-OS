#!/usr/bin/env bash
# Arctian OS C (musl, statik PIE ELF64) derleyici sarmalayicisi
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
TC="${ARCTIAN_TOOLCHAIN:-$HOME/arctian-toolchain}"
[ -f "$TC/env.sh" ] || { echo "Once sdk/toolchain/build-toolchain.sh calistirin" >&2; exit 1; }
source "$TC/env.sh"

CC_BIN="${ARCTIAN_HOST_CC:-gcc}"
SYS="$ARCTIAN_SYSROOT"
GLIB="$ARCTIAN_GCC_LIB"

PREV=""
for a in "$@"; do
    if [ "$a" = "-xc++" ] || { [ "$PREV" = "-x" ] && [ "$a" = "c++" ]; }; then
        exec "$SCRIPT_DIR/arctian-cxx" "$@"
    fi
    PREV="$a"
done

COMPILE_ONLY=0
HAS_OUT=0
[ $# -eq 0 ] && COMPILE_ONLY=1
for a in "$@"; do
    case "$a" in
        -c|-S|-E|-M|-MM|-fsyntax-only|--version|-dumpversion|-dumpfullversion|-dumpmachine|-dumpspecs|-print-*|--help)
            COMPILE_ONLY=1
            ;;
        -o|-o*)
            HAS_OUT=1
            ;;
    esac
done
if [ "$COMPILE_ONLY" -eq 0 ] && [ "$HAS_OUT" -eq 0 ]; then
    for a in "$@"; do
        case "$a" in -v) COMPILE_ONLY=1 ;; esac
    done
fi

CFLAGS=(
    -m64 -fPIE -fno-stack-protector
    -nostdinc
    -isystem "$SCRIPT_DIR/include"
    -isystem "$REPO_ROOT/include/arctian"
    -isystem "$GLIB/include"
    -isystem "$SYS/usr/include"
)

if [ "$COMPILE_ONLY" -eq 1 ]; then
    exec "$CC_BIN" "${CFLAGS[@]}" "$@"
else
    exec "$CC_BIN" "${CFLAGS[@]}" \
        -fno-use-linker-plugin \
        -nostdlib -static-pie \
        -Wl,-z,noexecstack \
        "$SYS/usr/lib/rcrt1.o" \
        "$SYS/usr/lib/crti.o" \
        "$GLIB/crtbeginS.o" \
        "$@" \
        -L"$SYS/usr/lib" -L"$GLIB" \
        -Wl,--start-group -latomic -lc -lgcc -lgcc_eh -Wl,--end-group \
        "$GLIB/crtendS.o" \
        "$SYS/usr/lib/crtn.o"
fi
