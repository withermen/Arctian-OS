# Arctian OS CMake Cross-Compilation Toolchain (x86_64 pure-musl + libstdc++ 14.2 static-PIE)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

get_filename_component(_ARCTIAN_TC_DIR "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
set(ARCTIAN_SYSROOT "$ENV{HOME}/arctian-toolchain/sysroot")
if(DEFINED ENV{ARCTIAN_SYSROOT})
    set(ARCTIAN_SYSROOT "$ENV{ARCTIAN_SYSROOT}")
endif()

set(CMAKE_C_COMPILER   "${_ARCTIAN_TC_DIR}/arctian-cc")
set(CMAKE_CXX_COMPILER "${_ARCTIAN_TC_DIR}/arctian-cxx")
set(CMAKE_AR           "/usr/bin/ar" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB       "/usr/bin/ranlib" CACHE FILEPATH "" FORCE)
set(CMAKE_STRIP        "/usr/bin/strip" CACHE FILEPATH "" FORCE)
set(PKG_CONFIG_EXECUTABLE "${_ARCTIAN_TC_DIR}/arctian-pkg-config" CACHE FILEPATH "" FORCE)

set(CMAKE_FIND_ROOT_PATH "${ARCTIAN_SYSROOT}/usr")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_FIND_LIBRARY_SUFFIXES ".a")

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
