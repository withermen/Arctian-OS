# Gizli imzalama anahtarlari ve gelistirici araclari - depoya/asla girmez.
# Uc derleme betigi istisna: depodan temiz checkout derlenebilsin diye.
tools/*
!tools/bin2c.py
!tools/arctianpack.py
!tools/rust_compile_stub.sh
!tools/build-release.sh
tools/keys/
*.pem
*.key
*.pfx
.env
.id_rsa

